#!/bin/sh
# Blocks secrets and known-bad patterns before they enter history.
# Install:  git config core.hooksPath .githooks
# Bypass (rare, deliberate):  git commit --no-verify

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Never commit an env file
if echo "$staged" | grep -qE '(^|/)\.env$'; then
  echo "BLOCKED: .env is staged. It holds live API keys."
  fail=1
fi

# 2. Never commit the SQLite database
if echo "$staged" | grep -qE '\.db($|-shm$|-wal$)'; then
  echo "BLOCKED: a SQLite database is staged. It is runtime state, not source."
  fail=1
fi

# 3. Scan staged content for credential shapes
for f in $staged; do
  [ -f "$f" ] || continue
  case "$f" in
    .env.example|*.lock|*-lock.json) continue ;;
  esac

  if git show ":$f" 2>/dev/null | grep -qE 'sk-or-v1-[A-Za-z0-9]{20,}'; then
    echo "BLOCKED: $f contains an OpenRouter API key."
    fail=1
  fi

  if git show ":$f" 2>/dev/null | grep -qE '\b[0-9a-f]{32}\b'; then
    echo "BLOCKED: $f contains a 32-char hex string (TMDB-key shaped)."
    echo "         If this is a hash or checksum, commit with --no-verify."
    fail=1
  fi

  if git show ":$f" 2>/dev/null | grep -qE 'BEGIN (OPENSSH|RSA|EC) PRIVATE KEY'; then
    echo "BLOCKED: $f contains a private key."
    fail=1
  fi
done

# 4. Design guardrail — gradients are banned (see AGENTS.md)
for f in $staged; do
  case "$f" in
    frontend/src/*)
      if git show ":$f" 2>/dev/null | grep -qE '(linear|radial)-gradient'; then
        echo "BLOCKED: $f uses a gradient — banned for dark-room legibility."
        fail=1
      fi
      ;;
  esac
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit aborted. Fix the above, or use --no-verify if you are certain."
  exit 1
fi

exit 0
